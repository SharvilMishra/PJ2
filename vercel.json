{
  "services": {
    "frontend": {
      "root": "Frontend"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.py"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
